# Privileged actuator daemon. Runs as the user (systemd --user), the ONLY
# process allowed to synthesize input or spawn shells. Hardened with the
# strongest sandbox compatible with its job.
[Unit]
Description=Oracle of Delphi actuator daemon
After=default.target

[Service]
Type=simple
ExecStart=%h/.local/bin/oracle-actd --serve %t/oracle/actd.sock
Restart=always
RestartSec=1
# The socket dir lives under the runtime dir ($XDG_RUNTIME_DIR = %t).
RuntimeDirectory=oracle
RuntimeDirectoryMode=0700
# Hardening: no new privileges, restricted syscalls, private tmp.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
# actd needs /dev/uinput for input injection; grant only that device.
DeviceAllow=/dev/uinput rw
# Keep it from acquiring capabilities it should never have.
CapabilityBoundingSet=CAP_SYS_NICE
RestrictRealtime=false

[Install]
WantedBy=default.target
