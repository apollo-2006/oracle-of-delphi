# The real-time audio engine. Given RT scheduling (SCHED_FIFO) and memory
# locking so the capture/VAD hot path never pages or preempts late.
[Unit]
Description=Oracle of Delphi audio engine
After=oracle-core.service
Wants=oracle-core.service

[Service]
Type=simple
ExecStart=%h/.local/bin/oracle-audio
Restart=always
RestartSec=1
# Real-time audio needs these; the user must be in a group with rtprio limits
# (see /etc/security/limits.d/audio.conf on most distros).
LimitRTPRIO=95
LimitMEMLOCK=infinity
# Pro-audio: keep the CPU governor from starving the capture thread.
CPUSchedulingPolicy=fifo
CPUSchedulingPriority=80

[Install]
WantedBy=default.target
