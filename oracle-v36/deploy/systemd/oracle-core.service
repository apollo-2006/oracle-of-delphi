# The orchestrator. Depends on actd being up so its socket exists.
[Unit]
Description=Oracle of Delphi core orchestrator
After=oracle-actd.service
Wants=oracle-actd.service

[Service]
Type=simple
ExecStart=%h/.local/bin/oracle-core run --config %h/.config/oracle/oracle.toml
Restart=on-failure
RestartSec=2
# Warm restart: the session snapshot + SQLite WAL survive restarts.
Environment=RUST_LOG=oracle_core=info
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
