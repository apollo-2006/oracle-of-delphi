# =========================
# Secrets & Local Config
# =========================
credentials.json
.env
.cache/

# =========================
# Fetched / built by scripts/setup.{sh,ps1}
# =========================
# Per-platform binaries and the models they load. These are what make a clone
# work on this machine; they are deliberately NOT committed, because a binary per
# platform doubles the repository, git keeps every past copy of one forever, and
# committing them redistributes other projects' code and data under their terms.
# Everything under piper/ and whisper/ comes from the setup scripts, including
# the voice model, which is fetched and checked against a pinned SHA-256.
/piper/
/whisper/

# setup.sh clones whisper.cpp here to build it; it is scratch, not source.
.build/

# A session snapshot is written next to the database, so an in-memory database
# (`db_path = ":memory:"`, used by the container profile and the tests) leaves a
# literal ":memory:.ses" in the working directory.
:memory:*

# =========================
# Local build dependencies
# =========================
# llama.cpp is cloned and built per-platform (Metal on macOS, ROCm/Vulkan on
# Windows), so it is a local checkout, not repository content.
#
# It was previously committed as a GITLINK -- mode 160000, a submodule entry --
# with no .gitmodules to go with it. Nothing could ever populate that: a fresh
# clone got an empty llama.cpp/ directory, and `git submodule update --init`
# had no config to read, so it silently did nothing. That is exactly how this
# checkout arrived with no inference backend at all.
llama.cpp/

# =========================
# AI Models & Large Files
# =========================
# Catches Whisper and other raw binaries
*.bin
# Catches standard GGUF models
*.gguf
# Catches Qwen and chunked model files
qwen2.5*
*-of-*

# =========================
# Rust (Backend)
# =========================
/target/
**/*.rs.bk
# Note: Cargo.lock is intentionally NOT ignored for binary projects/workspaces

# =========================
# Python (Virtual Env & Cache)
# =========================
venv/
.venv/
__pycache__/
*.py[cod]
*$py.class

# =========================
# Node.js & Vite (HUD/Frontend)
# =========================
node_modules/
dist/
dist-ssr/
npm-debug.log*
yarn-error.log*
yarn-debug.log*
pnpm-debug.log*

# =========================
# IDEs & OS Files
# =========================
.idea/
.vscode/
.DS_Store
Thumbs.db
dist-demo/
